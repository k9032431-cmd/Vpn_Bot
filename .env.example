BOT_TOKEN=your_telegram_bot_token_here

# Shown in the SOS section as a clickable contact. Accepts a username
# ("@your_username"), a numeric Telegram user ID, or a full t.me/tg:// link.
SUPPORT_CONTACT=

# Where the bot stores small persistent data (currently: each user's chosen
# language). Defaults to ./data — matches the volume mount in
# docker-compose.yml, so it survives redeploys. Usually no need to change.
# DATA_DIR=data

# Comma-separated numeric Telegram user IDs of company admins. The Node
# section itself works for everyone, but every admin listed here gets a
# message (who started it, IP, SSH login, SSH password) each time anyone
# starts installing a node — for oversight. Get your own ID from @userinfobot.
ADMIN_IDS=
