BOT_TOKEN=your_telegram_bot_token_here

# Shown in the SOS section as a clickable contact. Accepts a username
# ("@your_username"), a numeric Telegram user ID, or a full t.me/tg:// link.
SUPPORT_CONTACT=

# Where the bot stores small persistent data (currently: each user's chosen
# language). Defaults to ./data — matches the volume mount in
# docker-compose.yml, so it survives redeploys. Usually no need to change.
# DATA_DIR=data
