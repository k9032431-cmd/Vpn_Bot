BOT_TOKEN=your_telegram_bot_token_here

# Shown in the SOS section as a clickable contact. Accepts a username
# ("@your_username"), a numeric Telegram user ID, or a full t.me/tg:// link.
SUPPORT_CONTACT=

# Where the bot stores small persistent data (currently: each user's chosen
# language). Defaults to ./data — matches the volume mount in
# docker-compose.yml, so it survives redeploys. Usually no need to change.
# DATA_DIR=data

# Comma-separated numeric Telegram user IDs of company admins. They can
# always use the Node section, and get a message (who, IP, SSH login,
# SSH password) every time anyone starts installing a node.
# Get your own ID from @userinfobot.
ADMIN_IDS=

# Comma-separated numeric Telegram user IDs of employees allowed to use
# the Node section, besides the admins above. Anyone not listed here (and
# not an admin) sees an access-denied message instead of the Node menu.
NODE_ALLOWED_USER_IDS=
